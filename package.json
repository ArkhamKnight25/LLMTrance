{
  "name": "llmtrace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @llmtrace/web dev",
    "dev:api": "pnpm --filter @llmtrace/api dev",
    "dev:worker": "pnpm --filter @llmtrace/worker dev",
    "build:packages": "pnpm --filter @llmtrace/shared build && pnpm --filter @llmtrace/inference-sdk build",
    "build": "pnpm -r build",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "prisma": "5.22.0",
    "typescript": "^5.6.3"
  }
}
