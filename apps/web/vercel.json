{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm i -g pnpm@9.15.4 && cd ../.. && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @llmtrace/shared build && pnpm --filter @llmtrace/web build",
  "outputDirectory": ".next"
}
